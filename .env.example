# =============================================================================
# Stocky Inventory – Environment Variables
# =============================================================================
# Copy this file to .env.local (development) or .env (production) and fill in
# the values appropriate for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string (required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/stocky?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Authentication – NextAuth
# ---------------------------------------------------------------------------
# A random secret string used to sign NextAuth JWT tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# The canonical URL of your application (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentication – Custom JWT
# ---------------------------------------------------------------------------
# A random secret string used to sign the custom session_id cookie.
# Must be different from NEXTAUTH_SECRET.
JWT_SECRET="your-jwt-secret-here"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# The publicly accessible URL of the application (used by WebSocket CORS).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Winston log level: error | warn | info | http | verbose | debug | silly
# Defaults to "info" in production and "debug" in development.
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Rate Limiting (optional — configure in your reverse proxy or middleware)
# ---------------------------------------------------------------------------
# Maximum API requests per window per IP (informational — set in middleware)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# WebSocket (optional)
# ---------------------------------------------------------------------------
# Port for the Socket.IO server when running standalone (not needed for Next.js)
# WEBSOCKET_PORT=3001

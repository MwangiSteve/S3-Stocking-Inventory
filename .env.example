# ============================================================
# Environment Variables - Copy this file to .env.local
# and fill in the required values before running the project
# ============================================================

# --- Database ---
# MongoDB connection string (required)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# --- Authentication ---
# Secret key used to sign JWT tokens (required, min 32 chars)
JWT_SECRET="your-very-long-and-random-jwt-secret-here"

# NextAuth secret (required, generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Public URL of the application (required in production)
NEXTAUTH_URL="http://localhost:3000"

# --- Application ---
NODE_ENV="development"

# --- Rate Limiting (optional) ---
# Maximum number of requests per window for auth endpoints (default: 10)
RATE_LIMIT_AUTH_MAX=10

# Maximum number of requests per window for data endpoints (default: 100)
RATE_LIMIT_DATA_MAX=100

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
